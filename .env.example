# LLM Provider Configuration
# Provider priority: comma-separated. Tries first; falls back on rate-limit/error.
# Only providers with an API key configured will be used.
# Example: "groq,gemini,openrouter"
LLM_PROVIDER_PRIORITY=groq,gemini,openrouter

# --- Groq (free tier, no card) ---
# Live free IDs: openai/gpt-oss-20b (fast/cheap), openai/gpt-oss-120b (flagship).
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Google Gemini (free via AI Studio) ---
# gemini-2.5-flash is gated to legacy users; use 3.5-flash-lite for new projects.
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenRouter (free; no card) ---
# openrouter/free auto-routes to a rotating free model.
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated model priority list
OPENROUTER_MODELS=openrouter/free

# Paths
MODEL_PATH=models/model.pkl

# Logging
LOG_LEVEL=INFO
