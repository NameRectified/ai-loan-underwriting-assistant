# LLM Provider Configuration
# Provider priority: comma-separated. Tries first; falls back on rate-limit/error.
# Only providers with an API key configured will be used.
# Example: "groq,gemini,openrouter"
LLM_PROVIDER_PRIORITY=groq,gemini,openrouter

# --- Groq ---
# Rate limits apply per organization (all models share the same pool).
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini ---
# Rate limits apply per Google Cloud project (all models share the same pool).
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter ---
# OpenRouter routes to different underlying providers, so switching models
# can genuinely bypass rate limits on a particular provider.
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated model priority list
OPENROUTER_MODELS=google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct,mistralai/mistral-small-3.2-24b-instruct

# Paths
MODEL_PATH=models/model.pkl
STORAGE_PATH=data/applications.json

# Logging
LOG_LEVEL=INFO
